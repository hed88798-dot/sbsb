{
  "name": "ai-video-desktop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm dependency:check && pnpm portability:check",
    "dev": "pnpm --filter @app/desktop dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present build && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "dependency:check": "node tools/dependency-check.mjs",
    "secret:scan": "node tools/secret-scan.mjs",
    "license:scan": "node tools/license-audit.mjs",
    "portability:check": "node tools/portability-check.mjs",
    "native:rebuild": "electron-builder install-app-deps",
    "package:dir": "pnpm build && pnpm --filter @app/desktop package:dir"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "better-sqlite3": "13.0.3",
    "concurrently": "9.2.1",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.12",
    "eslint": "9.39.2",
    "eslint-plugin-import": "2.32.0",
    "globals": "16.5.0",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.1",
    "vite": "7.2.7",
    "vitest": "4.0.16",
    "wait-on": "9.0.3"
  }
}
