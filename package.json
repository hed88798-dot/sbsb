{
  "name": "ai-video-desktop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm compliance:license-policy:verify && pnpm compliance:artifact-license:verify && pnpm compliance:runtime-prerequisite:verify && pnpm compliance:python:tooling:install && pnpm ci:prepare && pnpm format:check && pnpm lint && pnpm ci:typecheck && pnpm ci:test && pnpm dependency:check && pnpm portability:check && pnpm workflow:security && pnpm secret:scan && pnpm license:scan && pnpm vulnerability:scan && pnpm compliance:python:verify && pnpm compliance:python:target:verify && pnpm golden:verify",
    "ci:prepare": "pnpm --filter @app/desktop... --filter @app/gateway... build",
    "ci:test": "vitest run",
    "ci:typecheck": "pnpm -r --if-present typecheck",
    "dev": "pnpm --filter @app/desktop dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm ci:prepare && pnpm ci:typecheck",
    "test": "pnpm ci:prepare && pnpm ci:test",
    "test:watch": "vitest",
    "dependency:check": "node tools/dependency-check.mjs",
    "workflow:security": "node tools/workflow-security-check.mjs",
    "secret:scan": "node tools/secret-scan.mjs",
    "license:scan": "node tools/license-audit.mjs",
    "license:release": "node tools/license-audit.mjs --release",
    "vulnerability:scan": "pnpm audit --audit-level moderate",
    "compliance:python:tooling:install": "node tools/python-supply-chain/quality-tooling.mjs",
    "compliance:license-policy:verify": "node tools/license-policy/verify-quality-tooling.mjs",
    "compliance:artifact-license:verify": "node tools/license-policy/verify-artifact-license-records.mjs",
    "compliance:runtime-prerequisite:verify": "node tools/runtime-prerequisite/verify-runtime-prerequisites.mjs",
    "compliance:runtime-prerequisite:release": "node tools/runtime-prerequisite/verify-runtime-prerequisites.mjs --require-approved",
    "compliance:license-policy:notices": "node tools/license-policy/notices.mjs",
    "compliance:python:verify": "node tools/python-supply-chain/cli.mjs repo-verify",
    "compliance:python:target:verify": "node tools/python-supply-chain/cli.mjs repo-target-verify-current",
    "compliance:python:inventory": "node tools/python-supply-chain/cli.mjs verify",
    "compliance:python:schema": "node tools/python-supply-chain/cli.mjs validate",
    "compliance:python:candidate": "node tools/python-supply-chain/create-candidate.mjs",
    "compliance:python:target": "node tools/python-supply-chain/target-descriptor.mjs",
    "compliance:python:migrate:v2": "node tools/python-supply-chain/migrate-v1-to-v2.mjs",
    "compliance:python:require-hashes": "node tools/python-supply-chain/generate-require-hashes.mjs",
    "compliance:python:license": "node tools/python-supply-chain/cli.mjs license",
    "compliance:python:vulnerability": "node tools/python-supply-chain/cli.mjs vulnerability",
    "compliance:python:toolchain:verify": "node tools/python-supply-chain/cli.mjs toolchain-verify",
    "compliance:python:toolchain:license": "node tools/python-supply-chain/cli.mjs toolchain-license",
    "compliance:python:toolchain:vulnerability": "node tools/python-supply-chain/cli.mjs toolchain-vulnerability",
    "compliance:python:toolchain:vulnerability-disposition": "node tools/python-supply-chain/cli.mjs toolchain-vulnerability-disposition",
    "compliance:approval:verify": "node tools/compliance/approval-provenance.mjs verify-contract",
    "compliance:python:build:verify": "node tools/python-supply-chain/cli.mjs build-provenance-verify",
    "compliance:python:artifact-usage:license": "node tools/python-supply-chain/cli.mjs artifact-usage-license",
    "compliance:python:native:inventory": "node tools/python-supply-chain/cli.mjs native-inventory",
    "compliance:python:packaged:verify": "node tools/python-supply-chain/cli.mjs repo-native-verify",
    "golden:verify": "node tools/golden/validate-manifest.mjs",
    "golden:update": "node tools/golden/update-manifest.mjs",
    "golden:validate": "pnpm golden:verify",
    "sbom:generate": "node tools/compliance/generate-sbom.mjs --output artifacts/compliance/SBOM.cdx.json",
    "clean-checkout": "node tools/clean-checkout.mjs",
    "artifact:metadata": "node tools/release/artifact-metadata.mjs",
    "package:resolution": "vitest run tests/contract/package-resolution.test.ts --maxWorkers=1",
    "portability:check": "node tools/portability-check.mjs",
    "native:rebuild": "electron-builder install-app-deps",
    "package:dir": "pnpm ci:prepare && pnpm --filter @app/desktop package:dir",
    "package:win": "pnpm ci:prepare && pnpm --filter @app/desktop exec electron-builder --win nsis --config electron-builder.yml"
  },
  "devDependencies": {
    "@app/provider-adapters": "workspace:*",
    "@electron/asar": "3.4.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "better-sqlite3": "13.0.3",
    "concurrently": "9.2.1",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.12",
    "eslint": "9.39.2",
    "eslint-plugin-import": "2.32.0",
    "globals": "16.5.0",
    "playwright-core": "1.55.0",
    "prettier": "3.7.4",
    "spdx-exceptions": "2.5.0",
    "spdx-expression-parse": "5.0.0",
    "spdx-license-ids": "3.0.23",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.1",
    "vite": "7.3.5",
    "vitest": "4.1.0",
    "wait-on": "9.0.3"
  }
}
