{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.app/schemas/provider/v1/text-capability.schema.json",
  "title": "TextCapabilityV1",
  "$defs": {
    "structuredOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "schema_name", "schema"],
      "properties": {
        "mode": { "const": "JSON_SCHEMA_STRICT" },
        "schema_name": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
        "schema": {
          "type": "object",
          "maxProperties": 8192,
          "additionalProperties": { "$ref": "#/$defs/jsonValue" },
          "description": "Runtime additionally enforces compact JSON UTF-8 size <=65536 bytes, depth <=32 (root 0), and <=8192 value nodes; only plain JSON data is accepted."
        }
      }
    },
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string", "maxLength": 65536 },
        { "type": "array", "maxItems": 8192, "items": { "$ref": "#/$defs/jsonValue" } },
        {
          "type": "object",
          "maxProperties": 8192,
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "capability",
        "model_alias",
        "prompt",
        "request_snapshot_hash"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "request_id": { "type": "string", "minLength": 1 },
        "capability": { "const": "text.generate.v1" },
        "model_alias": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 },
        "structured_output": { "$ref": "#/$defs/structuredOutput" },
        "request_snapshot_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "text",
        "provider_alias",
        "provider_model",
        "latency_ms",
        "billed_units",
        "request_snapshot_hash"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "request_id": { "type": "string", "minLength": 1 },
        "text": { "type": "string" },
        "provider_alias": { "type": "string", "minLength": 1 },
        "provider_model": { "type": "string", "minLength": 1 },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "billed_units": { "type": "number", "minimum": 0 },
        "request_snapshot_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  ]
}
