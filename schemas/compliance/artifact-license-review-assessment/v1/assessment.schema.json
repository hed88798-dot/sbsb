{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.app/schemas/compliance/artifact-license-review-assessment/v1/assessment.schema.json",
  "title": "Exact Artifact License Review Assessment v1",
  "description": "Structured closure of the original Code C review trigger. This is a companion to Artifact License Review v1 and never replaces its immutable approval record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "review_id",
    "artifact",
    "evidence_snapshot_sha256",
    "review_record_sha256",
    "original_review_trigger",
    "review_category",
    "review_trigger_resolution",
    "review_decision",
    "reviewed_spdx_expression",
    "evidence_references",
    "rationale",
    "assessment_sha256"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "assessment_id": { "$ref": "#/$defs/id" },
    "review_id": { "$ref": "#/$defs/id" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "filename", "sha256"],
      "properties": {
        "package": { "$ref": "#/$defs/nonEmpty" },
        "version": { "$ref": "#/$defs/nonEmpty" },
        "filename": { "$ref": "#/$defs/nonEmpty" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidence_snapshot_sha256": { "$ref": "#/$defs/sha256" },
    "review_record_sha256": { "$ref": "#/$defs/sha256" },
    "original_review_trigger": { "$ref": "#/$defs/nonEmpty" },
    "review_category": {
      "enum": [
        "LEGACY_SPDX_CANONICALIZATION",
        "UPSTREAM_RELEASE_COVERAGE",
        "COMPONENT_PATH_COVERAGE",
        "MULTI_LICENSE_RELATIONSHIP",
        "AMBIGUOUS_LICENSE_EVIDENCE",
        "OTHER"
      ]
    },
    "review_trigger_resolution": { "enum": ["RESOLVED", "UNRESOLVED"] },
    "review_decision": { "enum": ["APPROVED", "BLOCKED"] },
    "reviewed_spdx_expression": { "type": ["string", "null"], "minLength": 1 },
    "evidence_references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmpty" }
    },
    "rationale": { "$ref": "#/$defs/nonEmpty" },
    "assessment_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nonEmpty": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" }
  }
}
