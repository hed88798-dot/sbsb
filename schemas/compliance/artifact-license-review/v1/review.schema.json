{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.app/schemas/compliance/artifact-license-review/v1/review.schema.json",
  "title": "Exact Artifact License Review v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "action",
    "artifact",
    "evidence_snapshot_sha256",
    "reviewed_spdx_expression",
    "review_reason",
    "evidence_references",
    "supersedes_review_id",
    "revokes_review_id",
    "reviewer",
    "review_policy",
    "review_record_sha256"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "review_id": { "$ref": "#/$defs/id" },
    "action": { "enum": ["APPROVE", "SUPERSEDE", "REVOKE"] },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "filename", "sha256"],
      "properties": {
        "package": { "$ref": "#/$defs/nonEmpty" },
        "version": { "$ref": "#/$defs/nonEmpty" },
        "filename": { "$ref": "#/$defs/nonEmpty" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidence_snapshot_sha256": { "$ref": "#/$defs/sha256" },
    "reviewed_spdx_expression": { "type": ["string", "null"], "minLength": 1 },
    "review_reason": { "$ref": "#/$defs/nonEmpty" },
    "evidence_references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmpty" }
    },
    "supersedes_review_id": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "revokes_review_id": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "role",
        "authority_id",
        "approval_method",
        "approval_timestamp",
        "approval_reference"
      ],
      "properties": {
        "identity": { "$ref": "#/$defs/nonEmpty" },
        "role": { "const": "LICENSE_COMPLIANCE_APPROVER" },
        "authority_id": { "$ref": "#/$defs/id" },
        "approval_method": { "const": "CONTROLLED_PULL_REQUEST_REQUIRED_REVIEW" },
        "approval_timestamp": { "type": "string", "format": "date-time" },
        "approval_reference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "pull_request", "approved_commit_sha", "approval_event_id"],
          "properties": {
            "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
            "pull_request": { "type": "integer", "minimum": 1 },
            "approved_commit_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "approval_event_id": { "$ref": "#/$defs/nonEmpty" }
          }
        }
      }
    },
    "review_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "version", "policy_sha256", "tool_version"],
      "properties": {
        "policy_id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/nonEmpty" },
        "policy_sha256": { "$ref": "#/$defs/sha256" },
        "tool_version": { "const": "1" }
      }
    },
    "review_record_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nonEmpty": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" }
  }
}
