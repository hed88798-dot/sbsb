{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.app/schemas/compliance/artifact-approval-provenance/v1/authority-policy.schema.json",
  "title": "Artifact Approval Reviewer Authority Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "canonicalization_version",
    "authorities"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "policy_id": { "$ref": "#/$defs/id" },
    "policy_version": { "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}$", "type": "string" },
    "canonicalization_version": { "const": "json-utf8-lf-v1" },
    "authorities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewer", "reviewer_role", "reviewer_authority", "scopes"],
        "properties": {
          "reviewer": { "type": "string", "minLength": 1 },
          "reviewer_role": { "type": "string", "minLength": 1 },
          "reviewer_authority": { "type": "string", "minLength": 1 },
          "scopes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["PYTHON_ARTIFACT_INVENTORY_PROVENANCE", "TOOLCHAIN_PROVENANCE_APPROVAL"]
            }
          }
        }
      }
    },
    "policy_notes": { "type": "string" }
  },
  "$defs": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" } }
}
