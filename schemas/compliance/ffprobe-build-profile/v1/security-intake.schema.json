{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-video-platform.example/schemas/compliance/ffprobe-build-profile/v1/security-intake.schema.json",
  "title": "FFmpeg Release Security Intake",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_kind",
    "snapshot_id",
    "snapshot_sha256",
    "reviewed_at",
    "selected_release",
    "evidence_sources",
    "known_relevant_advisories_reviewed",
    "product_relevance",
    "outcome",
    "recheck_triggers"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "snapshot_kind": { "const": "FFMPEG_RELEASE_SECURITY_INTAKE" },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "snapshot_sha256": { "$ref": "#/$defs/sha256" },
    "reviewed_at": { "type": "string", "format": "date" },
    "review_owner": { "type": "string", "minLength": 1 },
    "review_scope": { "type": "string", "minLength": 1 },
    "selected_release": { "type": "object" },
    "evidence_sources": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "known_relevant_advisories_reviewed": { "type": "array", "items": { "type": "object" } },
    "product_relevance": { "type": "object" },
    "outcome": { "type": "object" },
    "recheck_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
