{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-video-platform.example/schemas/compliance/ffprobe-build-profile/v1/profile.schema.json",
  "title": "Semantic FFprobe Build Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_kind",
    "profile_id",
    "profile_version",
    "profile_sha256",
    "product_capability_authority",
    "target_architecture_policy",
    "program_enablement",
    "required_product_capabilities",
    "provided_capabilities",
    "capability_coverage",
    "protocol_policy",
    "external_library_policy",
    "linkage_policy",
    "license_oriented_build_constraints",
    "build_configuration_constraints",
    "expected_build_output_classes",
    "distribution_member_selection_policy",
    "artifact_status",
    "recheck_triggers"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "profile_kind": { "const": "FFPROBE_BUILD_PROFILE" },
    "profile_id": { "type": "string", "minLength": 1 },
    "profile_version": { "const": 1 },
    "profile_sha256": { "$ref": "#/$defs/sha256" },
    "product_capability_authority": { "type": "object" },
    "target_architecture_policy": { "type": "object" },
    "program_enablement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["FFPROBE_PROGRAM", "FFMPEG_PROGRAM", "FFPLAY_PROGRAM"],
      "properties": {
        "FFPROBE_PROGRAM": { "const": "REQUIRED" },
        "FFMPEG_PROGRAM": { "enum": ["REQUIRED", "BUILD_ONLY", "DISABLED"] },
        "FFPLAY_PROGRAM": { "enum": ["REQUIRED", "BUILD_ONLY", "DISABLED"] }
      }
    },
    "required_product_capabilities": { "type": "object" },
    "provided_capabilities": { "type": "object" },
    "capability_coverage": { "type": "object" },
    "protocol_policy": { "type": "object" },
    "external_library_policy": { "type": "object" },
    "linkage_policy": { "type": "object" },
    "license_oriented_build_constraints": { "type": "object" },
    "build_configuration_constraints": { "type": "object" },
    "expected_build_output_classes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "distribution_member_selection_policy": { "type": "object" },
    "artifact_status": { "type": "object" },
    "recheck_triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
