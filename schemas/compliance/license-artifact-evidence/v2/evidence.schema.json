{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.app/schemas/compliance/license-artifact-evidence/v2/evidence.schema.json",
  "title": "Artifact License Evidence v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact",
    "package_license",
    "file_level_license_evidence",
    "scan",
    "evidence_status"
  ],
  "properties": {
    "schema_version": { "const": "2" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "filename",
        "sha256",
        "package",
        "version",
        "artifact_type",
        "download_url",
        "supplier",
        "review_status"
      ],
      "properties": {
        "artifact_id": { "type": "string", "pattern": "^urn:sha256:[a-f0-9]{64}$" },
        "filename": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "package": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "artifact_type": { "type": "string", "minLength": 1 },
        "download_url": { "type": "string", "format": "uri" },
        "supplier": { "type": "string", "minLength": 1 },
        "review_status": { "enum": ["APPROVED", "MANUAL_REVIEW", "REJECTED"] }
      }
    },
    "package_license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression", "metadata_status", "evidence_sources"],
      "properties": {
        "expression": { "type": "string", "minLength": 1 },
        "metadata_status": {
          "enum": ["SPDX_EXPRESSION", "LEGACY_DESCRIPTION_REVIEWED", "NO_METADATA_REVIEWED"]
        },
        "evidence_sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceSource" }
        }
      }
    },
    "file_level_license_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope_id",
          "relationship",
          "path_prefixes",
          "expression",
          "evidence_sources",
          "files"
        ],
        "properties": {
          "scope_id": { "$ref": "#/$defs/id" },
          "relationship": { "enum": ["OVERRIDES_PACKAGE_LICENSE", "ADDITIONAL_PERMISSION"] },
          "path_prefixes": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/relativePath" }
          },
          "expression": { "type": "string", "minLength": 1 },
          "evidence_sources": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/evidenceSource" }
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["relative_path", "sha256"],
              "properties": {
                "relative_path": { "$ref": "#/$defs/relativePath" },
                "sha256": { "$ref": "#/$defs/sha256" }
              }
            }
          }
        }
      }
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scanner",
        "scanner_version",
        "wheel_entry_count",
        "license_candidate_paths",
        "evidence_identity_sha256"
      ],
      "properties": {
        "scanner": { "const": "scan-pyinstaller-license-evidence.py" },
        "scanner_version": { "const": "1" },
        "wheel_entry_count": { "type": "integer", "minimum": 1 },
        "license_candidate_paths": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "evidence_identity_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidence_status": { "enum": ["PASS", "MANUAL_REVIEW", "CONFLICT", "FAIL"] }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "evidenceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "evidence_type"],
      "properties": {
        "evidence_id": { "$ref": "#/$defs/id" },
        "evidence_type": {
          "enum": [
            "METADATA_LICENSE_DESCRIPTION",
            "METADATA_LICENSE_EXPRESSION",
            "LICENSE_FILE",
            "EXCEPTION_SOURCE"
          ]
        },
        "relative_path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "value": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "format": "uri" }
      }
    }
  }
}
