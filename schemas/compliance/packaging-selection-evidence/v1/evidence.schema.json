{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.app/schemas/compliance/packaging-selection-evidence/v1/evidence.schema.json",
  "title": "Packaging Selection Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "build_context",
    "parser",
    "raw_evidence",
    "authoritative_native_entries",
    "selected_native_entries",
    "symlink_metadata"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "evidence_id": { "$ref": "#/$defs/id" },
    "build_context": { "$ref": "#/$defs/buildContext" },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "engine_version", "parser_name", "parser_version"],
      "properties": {
        "engine": { "const": "pyinstaller" },
        "engine_version": { "type": "string", "minLength": 1 },
        "parser_name": { "type": "string", "minLength": 1 },
        "parser_version": { "type": "string", "minLength": 1 }
      }
    },
    "raw_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analysis_toc", "pkg_toc", "exe_toc", "pyz_toc", "build_log", "specification"],
      "properties": {
        "analysis_toc": { "$ref": "#/$defs/evidenceArtifact" },
        "pkg_toc": { "$ref": "#/$defs/evidenceArtifact" },
        "exe_toc": { "$ref": "#/$defs/evidenceArtifact" },
        "pyz_toc": { "$ref": "#/$defs/evidenceArtifact" },
        "build_log": { "$ref": "#/$defs/evidenceArtifact" },
        "specification": { "$ref": "#/$defs/evidenceArtifact" }
      }
    },
    "authoritative_native_entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/selectedEntry" }
    },
    "selected_native_entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/selectedEntry" }
    },
    "symlink_metadata": {
      "type": "array",
      "items": { "$ref": "#/$defs/symlink" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,191}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "python_version"],
      "properties": {
        "os": { "enum": ["windows", "linux", "macos"] },
        "architecture": { "enum": ["x86_64", "arm64"] },
        "python_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "buildContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build_context_id",
        "code_commit_sha",
        "target",
        "cpython_artifact_sha256",
        "pyinstaller_artifact_sha256",
        "wheel_graph_sha256",
        "specification_sha256",
        "source_import_graph_sha256"
      ],
      "properties": {
        "build_context_id": { "$ref": "#/$defs/id" },
        "code_commit_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "target": { "$ref": "#/$defs/target" },
        "cpython_artifact_sha256": { "$ref": "#/$defs/sha256" },
        "pyinstaller_artifact_sha256": { "$ref": "#/$defs/sha256" },
        "wheel_graph_sha256": { "$ref": "#/$defs/sha256" },
        "specification_sha256": { "$ref": "#/$defs/sha256" },
        "source_import_graph_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidenceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": { "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "selectedEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "source_artifact_id",
        "source_artifact_sha256",
        "source_path",
        "internal_path",
        "payload_sha256",
        "owner_kind",
        "target",
        "build_context_id",
        "pyinstaller_stage",
        "pyinstaller_category",
        "required_in_final"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/id" },
        "source_artifact_id": { "$ref": "#/$defs/id" },
        "source_artifact_sha256": { "$ref": "#/$defs/sha256" },
        "source_path": { "$ref": "#/$defs/relativePath" },
        "internal_path": { "$ref": "#/$defs/relativePath" },
        "payload_sha256": { "$ref": "#/$defs/sha256" },
        "owner_kind": {
          "enum": [
            "WHEEL_OWNED_NATIVE",
            "CPYTHON_TOOLCHAIN_NATIVE",
            "SYSTEM_BUILD_RUNTIME_NATIVE",
            "DERIVED_NATIVE"
          ]
        },
        "target": { "$ref": "#/$defs/target" },
        "build_context_id": { "$ref": "#/$defs/id" },
        "pyinstaller_stage": { "enum": ["ANALYSIS_TOC", "PKG_TOC", "EXE_TOC"] },
        "pyinstaller_category": { "enum": ["BINARY", "EXTENSION"] },
        "required_in_final": { "type": "boolean" },
        "resolution_basis": { "type": "string", "minLength": 1 }
      }
    },
    "symlink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "internal_path",
        "target_path",
        "encoding",
        "typecode",
        "build_context_id"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/id" },
        "internal_path": { "$ref": "#/$defs/relativePath" },
        "target_path": { "$ref": "#/$defs/relativePath" },
        "encoding": { "const": "utf-8" },
        "typecode": { "const": "n" },
        "build_context_id": { "$ref": "#/$defs/id" }
      }
    }
  }
}
