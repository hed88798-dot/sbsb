{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.app/schemas/compliance/bundled-license-evidence/v1/evidence.schema.json",
  "title": "Bundled License Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scanner",
    "artifact",
    "metadata",
    "license_evidence_files",
    "native_artifacts",
    "bundled_components",
    "bundled_third_party_license_evidence",
    "evidence_identity_sha256"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "scanner": {
      "type": "object",
      "required": ["name", "version", "mode"],
      "properties": {
        "name": { "const": "code-f-wheel-license-evidence-scan" },
        "version": { "const": "1.0.0" },
        "mode": { "const": "OFFLINE_EXACT_BYTES" }
      }
    },
    "artifact": {
      "type": "object",
      "required": [
        "package",
        "version",
        "sha256",
        "filename",
        "size",
        "source",
        "source_index",
        "download_url",
        "supplier",
        "review_status",
        "name",
        "license_expression",
        "archive_inventory_sha256"
      ],
      "properties": {
        "package": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "filename": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 1 },
        "source": { "type": "string", "format": "uri" },
        "source_index": { "type": "string", "format": "uri" },
        "download_url": { "type": "string", "format": "uri" },
        "supplier": { "type": "string", "minLength": 1 },
        "review_status": { "const": "APPROVED" },
        "name": { "type": "string", "minLength": 1 },
        "license_expression": { "type": "string", "minLength": 1 },
        "archive_inventory_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "relative_path",
        "sha256",
        "name",
        "version",
        "license_expression",
        "license_files"
      ],
      "properties": {
        "relative_path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "license_expression": { "type": "string", "minLength": 1 },
        "license_files": { "type": "array", "items": { "type": "string" } }
      }
    },
    "license_evidence_files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/hashedFile" }
    },
    "native_artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/nativeFile" }
    },
    "bundled_components": {
      "type": "array",
      "items": { "$ref": "#/$defs/bundledComponent" }
    },
    "bundled_third_party_license_evidence": {
      "enum": ["DETECTED_AND_SEPARATELY_RECORDED", "NONE_DETECTED_BY_APPROVED_SCAN"]
    },
    "evidence_identity_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "hashedFile": {
      "type": "object",
      "required": [
        "relative_path",
        "size",
        "sha256",
        "normalized_lf_sha256",
        "materialized_text_sha256"
      ],
      "properties": {
        "relative_path": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "normalized_lf_sha256": { "$ref": "#/$defs/sha256" },
        "materialized_text_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "nativeFile": {
      "type": "object",
      "required": ["relative_path", "size", "sha256"],
      "properties": {
        "relative_path": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "bundledComponent": {
      "type": "object",
      "required": [
        "component_id",
        "name",
        "version",
        "license_expression",
        "section_marker",
        "license_file_basename",
        "evidence_relative_path",
        "evidence_sha256",
        "evidence_normalized_lf_sha256",
        "evidence_materialized_text_sha256",
        "inclusion_evidence"
      ],
      "properties": {
        "component_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": ["string", "null"] },
        "license_expression": { "type": "string", "minLength": 1 },
        "section_marker": { "type": "string", "minLength": 1 },
        "license_file_basename": { "type": "string", "minLength": 1 },
        "evidence_relative_path": { "type": "string", "minLength": 1 },
        "evidence_sha256": { "$ref": "#/$defs/sha256" },
        "evidence_normalized_lf_sha256": { "$ref": "#/$defs/sha256" },
        "evidence_materialized_text_sha256": { "$ref": "#/$defs/sha256" },
        "inclusion_evidence": { "const": "LICENSE_SECTION_IN_DISTRIBUTED_WHEEL" }
      }
    }
  }
}
