{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.app/schemas/compliance/python-artifact-inventory/v3/inventory.schema.json",
  "title": "Python Artifact Inventory v3",
  "description": "Immutable Python artifact facts. Approval and review lifecycle are external companion records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inventory_id",
    "scope",
    "subject_state",
    "target",
    "graph_complete",
    "packages"
  ],
  "properties": {
    "schema_version": { "const": "3" },
    "inventory_id": { "$ref": "#/$defs/id" },
    "scope": {
      "enum": ["PRODUCTION_WORKER_RUNTIME", "WORKER_BUILD", "MODEL_EXPORT", "MODEL_EVALUATION"]
    },
    "subject_state": { "const": "CANDIDATE" },
    "target": { "$ref": "#/$defs/target" },
    "graph_complete": { "const": true },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/package" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "wheelTag": { "type": "string", "pattern": "^[A-Za-z0-9_.]+-[A-Za-z0-9_.]+-[A-Za-z0-9_.]+$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "httpsUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_descriptor_version",
        "implementation",
        "python_version",
        "os",
        "architecture",
        "compatibility"
      ],
      "properties": {
        "target_descriptor_version": { "const": "1" },
        "implementation": { "const": "cpython" },
        "python_version": { "type": "string", "pattern": "^3\\.[0-9]+\\.[0-9]+$" },
        "os": { "enum": ["windows", "linux"] },
        "architecture": { "enum": ["x86_64", "arm64"] },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "compatibility_engine",
            "compatibility_engine_version",
            "packaging_version",
            "wheel_tag_parser",
            "wheel_tag_parser_version",
            "tag_source",
            "compatible_tags",
            "compatible_tags_sha256"
          ],
          "properties": {
            "compatibility_engine": { "const": "pypa-packaging" },
            "compatibility_engine_version": { "const": "1" },
            "packaging_version": { "const": "25.0" },
            "wheel_tag_parser": { "const": "packaging.utils.parse_wheel_filename" },
            "wheel_tag_parser_version": { "const": "25.0" },
            "tag_source": {
              "enum": ["packaging.tags.sys_tags", "packaging.tags.cpython_tags+compatible_tags"]
            },
            "compatible_tags": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/wheelTag" }
            },
            "compatible_tags_sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "licenseFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256"],
      "properties": {
        "relative_path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "nativeArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "relative_path",
        "packaged_relative_path",
        "sha256",
        "type",
        "source_package"
      ],
      "properties": {
        "filename": { "type": "string", "minLength": 1 },
        "relative_path": { "$ref": "#/$defs/relativePath" },
        "packaged_relative_path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "type": { "enum": ["pyd", "dll", "so", "dylib", "other"] },
        "source_package": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supplier", "download_url"],
      "properties": {
        "supplier": { "type": "string", "minLength": 1 },
        "download_url": { "$ref": "#/$defs/httpsUrl" },
        "upstream_signature": { "type": ["string", "null"] },
        "notes": { "type": "string" }
      }
    },
    "compatibilityResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "matched_tags"],
      "properties": {
        "status": { "const": "COMPATIBLE" },
        "matched_tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/wheelTag" }
        }
      }
    },
    "dependencyDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement", "package_name", "disposition", "purl", "reason"],
      "properties": {
        "requirement": { "type": "string", "minLength": 1 },
        "package_name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "disposition": { "enum": ["INCLUDED", "NOT_APPLICABLE"] },
        "purl": { "type": ["string", "null"], "pattern": "^pkg:pypi/[a-z0-9._-]+@[^?/#]+$" },
        "reason": { "type": "string" }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_name",
        "version",
        "artifact_type",
        "filename",
        "artifact_path",
        "sha256",
        "source",
        "source_index",
        "purl",
        "wheel_tags",
        "compatibility",
        "license_expression",
        "license_files",
        "native_artifacts",
        "provenance",
        "direct",
        "dependencies",
        "dependency_declarations"
      ],
      "properties": {
        "package_name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "version": { "type": "string", "minLength": 1 },
        "artifact_type": { "const": "wheel" },
        "filename": { "type": "string", "minLength": 1 },
        "artifact_path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "source": { "$ref": "#/$defs/httpsUrl" },
        "source_index": { "$ref": "#/$defs/httpsUrl" },
        "purl": { "type": "string", "pattern": "^pkg:pypi/[a-z0-9._-]+@[^?/#]+$" },
        "wheel_tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/wheelTag" }
        },
        "compatibility": { "$ref": "#/$defs/compatibilityResult" },
        "license_expression": { "type": "string", "minLength": 1 },
        "license_files": { "type": "array", "items": { "$ref": "#/$defs/licenseFile" } },
        "native_artifacts": { "type": "array", "items": { "$ref": "#/$defs/nativeArtifact" } },
        "provenance": { "$ref": "#/$defs/provenance" },
        "direct": { "type": "boolean" },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^pkg:pypi/[a-z0-9._-]+@[^?/#]+$" }
        },
        "dependency_declarations": {
          "type": "array",
          "items": { "$ref": "#/$defs/dependencyDeclaration" }
        }
      }
    }
  }
}
