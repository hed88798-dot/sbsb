{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.app/schemas/compliance/python-artifact-inventory/v1/inventory.schema.json",
  "title": "Python Artifact Inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "inventory_id", "scope", "target", "graph_complete", "packages"],
  "properties": {
    "schema_version": { "const": "1" },
    "inventory_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "scope": {
      "enum": ["PRODUCTION_WORKER_RUNTIME", "WORKER_BUILD", "MODEL_EXPORT", "MODEL_EVALUATION"]
    },
    "target": { "$ref": "#/$defs/target" },
    "graph_complete": { "const": true },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/package" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "httpsUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python_version", "python_tag", "abi_tag", "platform_tag"],
      "properties": {
        "python_version": { "type": "string", "pattern": "^3\\.[0-9]+(?:\\.[0-9]+)?$" },
        "python_tag": { "type": "string", "pattern": "^[a-z0-9_.]+$" },
        "abi_tag": { "type": "string", "pattern": "^[a-z0-9_.]+$" },
        "platform_tag": { "type": "string", "pattern": "^[a-zA-Z0-9_.]+$" }
      }
    },
    "licenseFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256"],
      "properties": {
        "relative_path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "nativeArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "relative_path",
        "packaged_relative_path",
        "sha256",
        "type",
        "source_package"
      ],
      "properties": {
        "filename": { "type": "string", "minLength": 1 },
        "relative_path": { "$ref": "#/$defs/relativePath" },
        "packaged_relative_path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "type": { "enum": ["pyd", "dll", "so", "dylib", "other"] },
        "source_package": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supplier", "download_url", "review_status", "reviewed_at"],
      "properties": {
        "supplier": { "type": "string", "minLength": 1 },
        "download_url": { "$ref": "#/$defs/httpsUrl" },
        "review_status": { "const": "APPROVED" },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "upstream_signature": { "type": ["string", "null"] },
        "notes": { "type": "string" }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_name",
        "version",
        "artifact_type",
        "filename",
        "artifact_path",
        "sha256",
        "source",
        "source_index",
        "python_version",
        "python_tag",
        "abi_tag",
        "platform_tag",
        "purl",
        "license_expression",
        "license_files",
        "native_artifacts",
        "provenance",
        "direct",
        "dependencies",
        "dependency_declarations"
      ],
      "properties": {
        "package_name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "version": { "type": "string", "minLength": 1 },
        "artifact_type": { "enum": ["wheel", "sdist", "native", "other"] },
        "filename": { "type": "string", "minLength": 1 },
        "artifact_path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "source": { "$ref": "#/$defs/httpsUrl" },
        "source_index": { "$ref": "#/$defs/httpsUrl" },
        "python_version": { "type": "string", "pattern": "^3\\.[0-9]+(?:\\.[0-9]+)?$" },
        "python_tag": { "type": "string", "pattern": "^[a-z0-9_.]+$" },
        "abi_tag": { "type": "string", "pattern": "^[a-z0-9_.]+$" },
        "platform_tag": { "type": "string", "pattern": "^[a-zA-Z0-9_.]+$" },
        "purl": { "type": "string", "pattern": "^pkg:pypi/[a-z0-9._-]+@[^?/#]+$" },
        "license_expression": { "type": "string", "minLength": 1 },
        "license_files": { "type": "array", "items": { "$ref": "#/$defs/licenseFile" } },
        "native_artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/nativeArtifact" }
        },
        "provenance": { "$ref": "#/$defs/provenance" },
        "direct": { "type": "boolean" },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^pkg:pypi/[a-z0-9._-]+@[^?/#]+$" }
        },
        "dependency_declarations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requirement", "package_name", "disposition", "purl", "reason"],
            "properties": {
              "requirement": { "type": "string", "minLength": 1 },
              "package_name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "disposition": { "enum": ["INCLUDED", "NOT_APPLICABLE"] },
              "purl": {
                "type": ["string", "null"],
                "pattern": "^pkg:pypi/[a-z0-9._-]+@[^?/#]+$"
              },
              "reason": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
