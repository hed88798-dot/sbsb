{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.app/schemas/material-selection/v1/selection-decision-receipt.schema.json",
  "title": "SelectionDecisionReceiptV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "selection_request_id",
    "batch_id",
    "video_id",
    "slot_id",
    "status",
    "selected_asset_id",
    "selected_shot_id",
    "selected_semantic_rank",
    "selected_semantic_score",
    "degradation_level",
    "reason_codes",
    "candidate_set_hash",
    "history_snapshot_hash",
    "policy_id",
    "policy_version",
    "policy_snapshot_hash",
    "candidate_facts"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "selection_request_id": { "$ref": "#/$defs/identity" },
    "batch_id": { "$ref": "#/$defs/identity" },
    "video_id": { "$ref": "#/$defs/identity" },
    "slot_id": { "$ref": "#/$defs/identity" },
    "status": { "enum": ["SELECTED", "NO_MATCH"] },
    "selected_asset_id": { "anyOf": [{ "$ref": "#/$defs/identity" }, { "type": "null" }] },
    "selected_shot_id": { "anyOf": [{ "$ref": "#/$defs/identity" }, { "type": "null" }] },
    "selected_semantic_rank": {
      "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
    },
    "selected_semantic_score": { "type": ["number", "null"] },
    "degradation_level": { "type": "integer", "minimum": 0 },
    "reason_codes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reason" } },
    "candidate_set_hash": { "$ref": "#/$defs/hash" },
    "history_snapshot_hash": { "$ref": "#/$defs/hash" },
    "policy_id": { "const": "material-selection-policy-v1" },
    "policy_version": { "$ref": "#/$defs/identity" },
    "policy_snapshot_hash": { "$ref": "#/$defs/hash" },
    "candidate_facts": { "type": "array", "items": { "$ref": "#/$defs/facts" } }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "SELECTED" } }, "required": ["status"] },
      "then": {
        "properties": {
          "selected_asset_id": { "$ref": "#/$defs/identity" },
          "selected_shot_id": { "$ref": "#/$defs/identity" },
          "selected_semantic_rank": { "type": "integer", "minimum": 1 },
          "selected_semantic_score": { "type": "number" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "NO_MATCH" } }, "required": ["status"] },
      "then": {
        "properties": {
          "selected_asset_id": { "type": "null" },
          "selected_shot_id": { "type": "null" },
          "selected_semantic_rank": { "type": "null" },
          "selected_semantic_score": { "type": "null" },
          "degradation_level": { "const": 0 }
        }
      }
    }
  ],
  "$defs": {
    "identity": { "type": "string", "minLength": 1, "maxLength": 256 },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reason": {
      "enum": [
        "FRESH_UNUSED_CANDIDATE",
        "LOWEST_BATCH_USAGE",
        "RECENCY_PREFERRED",
        "LOWEST_TOTAL_USAGE",
        "SEMANTIC_RANK_PREFERRED",
        "SAME_ASSET_DIFFERENT_SHOT",
        "REPEAT_DUE_TO_SCARCITY",
        "NO_UPSTREAM_CANDIDATES",
        "ALL_CANDIDATES_HARD_REJECTED",
        "STABLE_IDENTITY_TIE_BREAK"
      ]
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "shot_id",
        "hard_rejection_codes",
        "fresh",
        "recently_used",
        "batch_asset_usage",
        "batch_shot_usage",
        "total_asset_usage",
        "total_shot_usage",
        "semantic_rank",
        "semantic_score"
      ],
      "properties": {
        "asset_id": { "$ref": "#/$defs/identity" },
        "shot_id": { "$ref": "#/$defs/identity" },
        "hard_rejection_codes": {
          "type": "array",
          "items": {
            "enum": ["DISABLED", "MATERIAL_FAMILY_MISMATCH", "SAME_VIDEO_EXACT_SHOT_REPEAT"]
          }
        },
        "fresh": { "type": "boolean" },
        "recently_used": { "type": "boolean" },
        "batch_asset_usage": { "type": "integer", "minimum": 0 },
        "batch_shot_usage": { "type": "integer", "minimum": 0 },
        "total_asset_usage": { "type": "integer", "minimum": 0 },
        "total_shot_usage": { "type": "integer", "minimum": 0 },
        "semantic_rank": { "type": "integer", "minimum": 1 },
        "semantic_score": { "type": "number" }
      }
    }
  }
}
