{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.app/schemas/ipc/v1/job.schema.json",
  "title": "JobDTOv1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "job_type",
    "state",
    "progress",
    "created_at",
    "started_at",
    "finished_at",
    "error_code",
    "error_message",
    "request_snapshot_hash"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "job_id": { "type": "string", "minLength": 1 },
    "job_type": { "type": "string", "minLength": 1 },
    "state": { "enum": ["QUEUED", "RUNNING", "SUCCEEDED", "FAILED", "CANCELLED", "INTERRUPTED"] },
    "progress": { "type": "number", "minimum": 0, "maximum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "started_at": { "type": ["string", "null"], "format": "date-time" },
    "finished_at": { "type": ["string", "null"], "format": "date-time" },
    "error_code": { "type": ["string", "null"] },
    "error_message": { "type": ["string", "null"] },
    "request_snapshot_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
