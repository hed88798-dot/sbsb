{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.app/schemas/source-document/v1/canonical-source-document.schema.json",
  "title": "CanonicalSourceDocumentV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_document_id",
    "source_document_version",
    "source_document_hash",
    "source_hash_scheme",
    "source_offset_unit",
    "source_kind",
    "text",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "source_document_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "source_document_version": { "type": "integer", "minimum": 1 },
    "source_document_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_hash_scheme": { "const": "SHA256_UTF8_EXACT_V1" },
    "source_offset_unit": { "const": "UNICODE_CODE_POINT" },
    "source_kind": { "const": "SCRIPT_VERSION" },
    "text": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
