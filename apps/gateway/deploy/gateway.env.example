GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=4400
GATEWAY_DB_PATH=/var/lib/ai-video-gateway/gateway.db
GATEWAY_MIGRATIONS_PATH=/opt/ai-video-gateway/current/migrations/gateway-sqlite
GATEWAY_PROVIDER_CONFIG_PATH=/etc/ai-video-gateway/providers.json
GATEWAY_TOKEN_SECRET=<generate-at-least-32-random-bytes>
GATEWAY_CREDENTIAL_PEPPER=<generate-at-least-32-random-bytes>

S3_ENDPOINT=https://object-storage.example.invalid
S3_BUCKET=<short-lived-object-bucket>
S3_REGION=<region>
S3_ACCESS_KEY_ID=<secret-store-reference>
S3_SECRET_ACCESS_KEY=<secret-store-reference>

TEXT_PRIMARY_KEY=<secret-store-reference>
TEXT_PRIMARY_WEBHOOK_SECRET=<secret-store-reference>
IMAGE_PRIMARY_KEY=<secret-store-reference>
IMAGE_PRIMARY_WEBHOOK_SECRET=<secret-store-reference>
IMAGE_FALLBACK_KEY=<secret-store-reference>
IMAGE_FALLBACK_WEBHOOK_SECRET=<secret-store-reference>
