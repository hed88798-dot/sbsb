{
  "name": "@app/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "build": "pnpm build:main && pnpm build:preload && pnpm build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --outfile=dist-electron/preload/index.cjs --external:electron",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"pnpm build:main --watch\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "package:dir": "electron-builder --dir --config electron-builder.yml"
  },
  "dependencies": {
    "@app/contracts": "workspace:*",
    "@app/domain-copywriting": "workspace:*",
    "@app/domain-product": "workspace:*",
    "@app/local-db": "workspace:*",
    "@app/provider-client": "workspace:*",
    "@tanstack/react-query": "5.90.20",
    "antd": "6.1.4",
    "better-sqlite3": "13.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zustand": "5.0.9",
    "zod": "4.1.13"
  }
}
