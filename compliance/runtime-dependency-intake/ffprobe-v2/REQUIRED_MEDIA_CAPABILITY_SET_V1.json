  "authority_interpretation": "The frozen V1 contract is local-filesystem media indexing followed by probe, shot detection, keyframes, quality and embedding. It intentionally does not name a finite extension allowlist; the FFprobe profile therefore preserves all upstream container/demuxer/parser coverage at the pinned release and may not silently narrow it.",
  "required_media_capabilities": {
    "input_scope": "LOCAL_FILESYSTEM_MEDIA",
    "input_locator": "EXPLICIT_LOCAL_FILESYSTEM_PATH",
    "probe_operation": "FFPROBE_JSON_SHOW_STREAMS_SHOW_FORMAT",
    "probe_fields": [
      "duration",
      "streams",
      "rotation",
      "frame_rate",
      "resolution",
      "pixel_format",
      "audio"
    ],
    "stream_semantics": [
      "AT_LEAST_ONE_VIDEO_STREAM",
      "AUDIO_STREAM_METADATA_OPTIONAL",
      "MULTI_STREAM_METADATA_PRESERVED"
    ],
    "downstream_consumers": ["SHOT_DETECTION_INPUT", "KEYFRAME_DECODE_INPUT", "SIGLIP_INDEX_INPUT"],
    "format_scope": "FORMAT_NEUTRAL_LOCAL_MEDIA",
    "container_capability_policy": "ALL_UPSTREAM_CONTAINERS_AT_PINNED_RELEASE",
    "demuxer_capability_policy": "ALL_UPSTREAM_DEMUXERS_AT_PINNED_RELEASE",
    "parser_capability_policy": "ALL_UPSTREAM_PARSERS_AT_PINNED_RELEASE",
    "malformed_media_behavior": "REJECT_FAIL_CLOSED",
    "network_media_input": "NOT_REQUIRED"
  },
  "scope_constraints": {
    "customer_media_upload_to_probe": "FORBIDDEN",
    "system_path_ffprobe": "FORBIDDEN",
    "implicit_format_narrowing": "FORBIDDEN",
    "capability_set_change_requires_new_version": true
  }
}
